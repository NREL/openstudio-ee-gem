  ems_Core_Retail_ZN_PSZ_AC_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {137676ea-8227-4730-af53-70d758e05a9a}<23.9 && {137676ea-8227-4730-af53-70d758e05a9a}>1.7, !- Program Line 1
  SET {ca7e3eb9-9585-401f-af83-2dcce4c6a3ba} = 29.4, !- Program Line 2
  SET {05be99c5-242b-4af8-8ae4-a6904194a9c9} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {137676ea-8227-4730-af53-70d758e05a9a}<23.9 && {137676ea-8227-4730-af53-70d758e05a9a}>1.7, !- Program Line 4
  SET {ca7e3eb9-9585-401f-af83-2dcce4c6a3ba} = 29.4, !- Program Line 5
  SET {05be99c5-242b-4af8-8ae4-a6904194a9c9} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {137676ea-8227-4730-af53-70d758e05a9a}<23.9 && {137676ea-8227-4730-af53-70d758e05a9a}>1.7, !- Program Line 7
  SET {ca7e3eb9-9585-401f-af83-2dcce4c6a3ba} = 29.4, !- Program Line 8
  SET {05be99c5-242b-4af8-8ae4-a6904194a9c9} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {137676ea-8227-4730-af53-70d758e05a9a}<23.9 && {137676ea-8227-4730-af53-70d758e05a9a}>1.7, !- Program Line 10
  SET {ca7e3eb9-9585-401f-af83-2dcce4c6a3ba} = 29.4, !- Program Line 11
  SET {05be99c5-242b-4af8-8ae4-a6904194a9c9} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {ca7e3eb9-9585-401f-af83-2dcce4c6a3ba} = NULL, !- Program Line 14
  SET {05be99c5-242b-4af8-8ae4-a6904194a9c9} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

