  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {093e8b52-b095-4f79-b44b-41023000a47e}<23.9 && {093e8b52-b095-4f79-b44b-41023000a47e}>1.7, !- Program Line 4
  SET {ad994646-c55e-4345-a617-6726f1ad1433} = 29.4, !- Program Line 5
  SET {fdff8549-0179-4832-91c8-2b3db9c88642} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {093e8b52-b095-4f79-b44b-41023000a47e}<23.9 && {093e8b52-b095-4f79-b44b-41023000a47e}>1.7, !- Program Line 7
  SET {ad994646-c55e-4345-a617-6726f1ad1433} = 29.4, !- Program Line 8
  SET {fdff8549-0179-4832-91c8-2b3db9c88642} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {093e8b52-b095-4f79-b44b-41023000a47e}<23.9 && {093e8b52-b095-4f79-b44b-41023000a47e}>1.7, !- Program Line 10
  SET {ad994646-c55e-4345-a617-6726f1ad1433} = 29.4, !- Program Line 11
  SET {fdff8549-0179-4832-91c8-2b3db9c88642} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {ad994646-c55e-4345-a617-6726f1ad1433} = NULL, !- Program Line 14
