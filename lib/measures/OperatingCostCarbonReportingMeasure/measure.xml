        </choice>
      </choices>
    </argument>
    <argument>
      <name>electricity_emission_factor</name>
      <display_name>Electricity Emission Factor (kg CO2e/kWh)</display_name>
      <description>Annual average electricity emission factor. US average ~0.42 kg CO2e/kWh. Leave 0 to use state default.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>gas_emission_factor</name>
      <display_name>Natural Gas Emission Factor (kg CO2e/therm)</display_name>
      <description>Natural gas emission factor. US average ~5.3 kg CO2e/therm. Leave 0 to use default.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>on_peak_rate</name>
      <display_name>On-Peak Electricity Rate ($/kWh)</display_name>
      <description>Electricity rate during on-peak hours (typically weekdays 12pm-6pm). Leave 0 to use state default.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>off_peak_rate</name>
      <display_name>Off-Peak Electricity Rate ($/kWh)</display_name>
      <description>Electricity rate during off-peak hours (nights and weekends). Leave 0 to use state default.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>demand_charge</name>
      <display_name>Monthly Demand Charge ($/kW)</display_name>
      <description>Monthly demand charge based on peak demand. Leave 0 to use state default or skip if not applicable.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>gas_rate</name>
      <display_name>Natural Gas Rate ($/therm)</display_name>
      <description>Natural gas cost per therm. Leave 0 to use state default.</description>
      <type>Double</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>0.0</default_value>
    </argument>
    <argument>
      <name>on_peak_start_hour</name>
      <display_name>On-Peak Start Hour (0-23)</display_name>
      <description>Hour when on-peak period starts (24-hour format)</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>12</default_value>
    </argument>
    <argument>
      <name>on_peak_end_hour</name>
      <display_name>On-Peak End Hour (0-23)</display_name>
      <description>Hour when on-peak period ends (24-hour format)</description>
      <type>Integer</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>18</default_value>
    </argument>
    <argument>
      <name>weekend_on_peak</name>
      <display_name>Include Weekends in On-Peak</display_name>
      <description>Check if weekends should be considered on-peak</description>
      <type>Boolean</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>false</default_value>
    </argument>
  </arguments>
